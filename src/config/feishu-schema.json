{
  "说明": "此文件为飞书多维表格建表参考，不需要被代码引用，仅作为手动建表时的对照文档",
  "bitableSchema": {
    "programs": {
      "tableName": "小程序公众号",
      "description": "存储所有提交的小程序和公众号信息（不含访问统计，访问统计在daily_stats表）",
      "fields": [
        { "fieldName": "名称", "type": "文本", "required": true },
        { "fieldName": "类型", "type": "单选", "options": ["miniapp", "official"], "required": true },
        { "fieldName": "描述", "type": "文本", "required": true },
        { "fieldName": "提交者", "type": "文本", "description": "提交者openid", "required": true },
        { "fieldName": "提交者名称", "type": "文本", "required": true },
        { "fieldName": "是否置顶", "type": "复选框", "defaultValue": false, "required": true },
        { "fieldName": "置顶到期时间", "type": "日期", "required": false },
        { "fieldName": "创建时间", "type": "日期", "required": true }
      ]
    },
    "users": {
      "tableName": "用户",
      "description": "存储用户基本信息和星尘余额（不含访问统计，访问统计在daily_stats表）",
      "fields": [
        { "fieldName": "openid", "type": "文本", "description": "微信用户唯一标识", "required": true },
        { "fieldName": "昵称", "type": "文本", "required": true },
        { "fieldName": "头像", "type": "文本", "required": false },
        { "fieldName": "星尘余额", "type": "数字", "defaultValue": 0, "required": true },
        { "fieldName": "签到日期", "type": "文本", "description": "逗号分隔，如 2025-01-15,2025-01-16", "required": false },
        { "fieldName": "创建时间", "type": "日期", "required": true }
      ]
    },
    "dailyStats": {
      "tableName": "每日统计",
      "description": "每个用户每天一条记录，追踪每日访问/被访问次数。核心优化：访问操作只需更新此表+用户星尘，最少请求",
      "fields": [
        { "fieldName": "日期", "type": "文本", "description": "格式 2025-01-15", "required": true },
        { "fieldName": "用户openid", "type": "文本", "required": true },
        { "fieldName": "访问次数", "type": "数字", "description": "当天访问他人的次数", "defaultValue": 0, "required": true },
        { "fieldName": "被访问次数", "type": "数字", "description": "当天被他人访问的次数", "defaultValue": 0, "required": true }
      ]
    },
    "transactions": {
      "tableName": "交易记录",
      "description": "星尘的所有收支记录",
      "fields": [
        { "fieldName": "用户openid", "type": "文本", "required": true },
        { "fieldName": "类型", "type": "单选", "options": ["sign_in", "watch_ad", "visit_reward", "redeem_top", "redeem_redpacket"], "required": true },
        { "fieldName": "金额", "type": "数字", "description": "正数=收入，负数=支出", "required": true },
        { "fieldName": "描述", "type": "文本", "required": true },
        { "fieldName": "创建时间", "type": "日期", "required": true }
      ]
    },
    "redemptions": {
      "tableName": "兑换码",
      "description": "红包和置顶的兑换码记录",
      "fields": [
        { "fieldName": "用户openid", "type": "文本", "required": true },
        { "fieldName": "类型", "type": "单选", "options": ["ranking_boost", "red_packet"], "required": true },
        { "fieldName": "兑换码", "type": "文本", "description": "格式 HELP-XXXX-XXXX", "required": true },
        { "fieldName": "金额", "type": "数字", "description": "红包金额（元），置顶填0", "required": true },
        { "fieldName": "星尘花费", "type": "数字", "required": true },
        { "fieldName": "状态", "type": "单选", "options": ["unused", "used", "expired"], "required": true },
        { "fieldName": "创建时间", "type": "日期", "required": true },
        { "fieldName": "使用时间", "type": "日期", "required": false }
      ]
    }
  }
}
